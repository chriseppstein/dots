{
  "name": "dots-3d",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Dots 3D - A three-dimensional version of the classic Dots and Boxes game",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config worker/wrangler.toml",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name dots-3d"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitest": "^3.2.4",
    "wrangler": "^4.107.0"
  }
}
